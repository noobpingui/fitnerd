# Copia este archivo como ".env" en la raiz del repo y coloca tus propios valores.
# docker-compose.yml lo lee automaticamente (misma carpeta) para resolver las
# variables ${...} sin que las credenciales reales queden en el yml versionado.

POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fitnerd

# Mismo valor que GOOGLE_CLIENT_ID en backend/.env - se necesita aca TAMBIEN
# porque docker-compose.yml resuelve sus propias variables ${...} solo desde
# el .env de esta carpeta (la raiz), nunca desde backend/.env ni
# frontend/.env - son mecanismos distintos aunque el valor sea el mismo.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
