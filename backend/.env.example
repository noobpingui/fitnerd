# dialect+driver://...
# - dialect = el tipo de DB (postgresql)
# - driver = la libreria que hace la conexion real (psycopg2)
# Normalmente psycopg2 es el default, por eso funciona sin ponerlo.

DEV_DATABASE_URL=postgresql+psycopg2://username:password@localhost:PORT/mydatabase

PROD_DATABASE_URL=postgresql+psycopg2://username:password@localhost:PORT/mydatabase

# Base de datos separada, solo para pytest - nunca la de desarrollo (los
# tests crean/borran tablas y datos libremente). Mismas credenciales que
# DEV_DATABASE_URL, cambia solo el nombre de la base.
TEST_DATABASE_URL=postgresql+psycopg2://username:password@localhost:PORT/mydatabase_test
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# redis://<host>:<puerto>/<numero de base> - el /0 al final es el numero de
# "base logica" de Redis (soporta 0-15 por instancia, una separacion liviana
# dentro del mismo Redis - no hace falta crear nada, ya existen todas).
REDIS_URL=redis://localhost:6379/0
